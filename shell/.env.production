# Build-time API base for the PRODUCTION builds — Shell (`npm run build`) and the
# production peer app (`npm run build:peer`). Both are cross-origin against the
# gateway custom domain (DL-028), so every origin using it must be registered as an
# Authorized Domain on the gateway (DL-082 §1) — manual function headers do not
# satisfy the OPTIONS preflight.
#
# No trailing slash: callers join as `${BASE}/accesscontrol/` (src/lib/api.ts,
# src/peer/lib/peerApi.ts).
VITE_API_BASE=https://api.habify30.k-a-d-o.com/server
